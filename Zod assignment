const { z } = require("zod");

const loginSchema = z.object({
  name: z.string().trim().min(2, "name must be atleast 2 character"),
  Email: z.string().trim().toLowerCase().email("Invalid Email"),
  Password: z.string().min(6, "Password must be atleast 6 characters"),
  Gender: z.string().trim().min(1, "Enter gender"),
  Address: z.string().trim().min(10, "address must contain at least 10 characters")
});

const name = prompt("Enter name:");
const Email = prompt("Enter Emails:");
const Password = prompt("Enter password:");
const Gender = prompt("Enter Gender:");
const Address = prompt("Enter Address:");

document.getElementById("loginForm").addEventListener("submit", (e) => {
  e.preventDefault();

  const result = loginSchema.safeParse({
    name,
    Email,
    Password,
    Gender,
    Address
  });

  const msg = document.getElementById("msg");

  if (!result.success) {
