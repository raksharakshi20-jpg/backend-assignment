
const request = require('supertest');
const app = require('../app');

describe('POST /auth/register', () => {

  it('accepts valid registration data (201)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'Asha',
        email: 'asha@example.com',
        password: 'abc@123',
        gender: 'female',
        address: 'Mumbai'
      });

    expect(res.status).toBe(201);
  });

  it('rejects a short name (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'A',
        email: 'asha@example.com',
        password: 'abc@123',
        gender: 'female',
        address: 'Mumbai'
      });

    expect(res.status).toBe(400);
  });

  it('rejects a bad email (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'Asha',
        email: 'abc',
        password: 'abc@123',
        gender: 'female',
        address: 'Mumbai'
      });

    expect(res.status).toBe(400);
  });

  it('rejects a short password (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'Asha',
        email: 'asha@example.com',
        password: '123',
        gender: 'female',
        address: 'Mumbai'
      });

    expect(res.status).toBe(400);
  });

  it('rejects missing gender (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'Asha',
        email: 'asha@example.com',
        password: 'abc@123',
        address: 'Mumbai'
      });

    expect(res.status).toBe(400);
  });

  it('rejects missing address (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({
        name: 'Asha',
        email: 'asha@example.com',
        password: 'abc@123',
        gender: 'female'
      });

    expect(res.status).toBe(400);
  });

  it('rejects empty registration data (400)', async () => {
    const res = await request(app)
      .post('/auth/register')
      .send({});

    expect(res.status).toBe(400);
  });

});
